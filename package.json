{
  "name": "codemem",
  "version": "0.1.0",
  "description": "Local-first MCP server and CLI that serves coding agents only the code context they need",
  "license": "MIT",
  "author": "Jaswanth Remiel AG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaswanthRemiel/codemem.git"
  },
  "type": "module",
  "bin": {
    "codemem": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts eslint.config.js vitest.config.js",
    "format": "prettier --write src scripts .github grammars/README.md \"test/*.{ts,mjs}\" \"*.{js,json}\" README.md DECISIONS.md PROGRESS.md SETUP.md",
    "format:check": "prettier --check src scripts .github grammars/README.md \"test/*.{ts,mjs}\" \"*.{js,json}\" README.md DECISIONS.md PROGRESS.md SETUP.md",
    "check:chars": "node scripts/check-chars.mjs",
    "test": "vitest run",
    "hooks": "git config core.hooksPath .githooks || exit 0",
    "prepare": "npm run build && npm run -s hooks",
    "coverage": "vitest run --coverage",
    "pretest": "npm run -s build",
    "precoverage": "npm run -s build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.1.1",
    "chokidar": "^5.0.0",
    "commander": "^15.1.0",
    "js-tiktoken": "^1.0.21",
    "sqlite-vec": "^0.1.9",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
