{
  "name": "remimem",
  "version": "0.1.0",
  "description": "Codebase memory for coding agents: a local-first MCP server and CLI that serves only the code context an agent needs",
  "license": "MIT",
  "author": "Jaswanth Remiel AG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaswanthRemiel/remimem.git"
  },
  "type": "module",
  "bin": {
    "remimem": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/bench",
    "grammars"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-dashboard.mjs && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dashboard/ui",
    "lint": "eslint src test scripts eslint.config.js vitest.config.js",
    "format": "prettier --write src scripts .github grammars/README.md \"docs/**/*.md\" \"test/*.{ts,mjs}\" \"*.{js,json}\" README.md DECISIONS.md PROGRESS.md SETUP.md CONTRIBUTING.md CHANGELOG.md RELEASING.md",
    "format:check": "prettier --check src scripts .github grammars/README.md \"docs/**/*.md\" \"test/*.{ts,mjs}\" \"*.{js,json}\" README.md DECISIONS.md PROGRESS.md SETUP.md CONTRIBUTING.md CHANGELOG.md RELEASING.md",
    "check:chars": "node scripts/check-chars.mjs",
    "test": "vitest run",
    "hooks": "git config core.hooksPath .githooks || exit 0",
    "prepare": "npm run build && npm run -s hooks",
    "coverage": "vitest run --coverage",
    "pretest": "npm run -s build",
    "precoverage": "npm run -s build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.1.1",
    "chokidar": "^5.0.0",
    "commander": "^15.1.0",
    "js-tiktoken": "^1.0.21",
    "sqlite-vec": "^0.1.9",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "cytoscape": "^3.35.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/JaswanthRemiel/remimem#readme",
  "bugs": {
    "url": "https://github.com/JaswanthRemiel/remimem/issues"
  },
  "keywords": [
    "mcp",
    "rag",
    "ai-agents",
    "code-search",
    "developer-tools",
    "model-context-protocol",
    "tree-sitter"
  ]
}
